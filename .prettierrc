{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 120,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",

  "plugins": ["@ianvs/prettier-plugin-sort-imports"],

  "importOrder": [
    "^(vue|vue-router|pinia)$",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@app(/.*)?$",
    "",
    "^@pages(/.*)?$",
    "",
    "^@widgets(/.*)?$",
    "",
    "^@features(/.*)?$",
    "",
    "^@entities(/.*)?$",
    "",
    "^@shared(/.*)?$",
    "",
    "^[./]"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
  "importOrderTypeScriptVersion": "5.0.0"
}
